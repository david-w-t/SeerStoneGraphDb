{erl_opts, [debug_info]}.

{deps, [
    {grpcbox, "0.17.1"}
]}.

{plugins, [
    grpcbox_plugin
]}.

{grpc, [
    {protos, ["priv/protos"]},
    {gpb_opts, [{module_name_suffix, "_pb"},
                {i, "priv/protos"},
                {i, "apps/graphdb_api/priv/protos"},
                {o, "src"}]}
]}.

{relx, [
    %% grpcbox MUST follow database in this list: grpcbox auto-starts its
    %% configured listener on its own application start (sys.config's
    %% {grpcbox, [{servers, [...]}]} entry), so this order is what
    %% guarantees the gRPC port never opens before the graph database
    %% (bootstrap included) is fully up. See docs/designs/grpc-proxy-api-design.md
    %% §6.1. Untested by any suite (see docs/graphdb-api-reference.md /
    %% TASKS.md) -- do not reorder without re-verifying.
    {release, {seerstone, "0.1.0"},
     [nref,
      database,
      seerstone,
      grpcbox,
      graphdb_api]},
    {sys_config, "config/sys.config"},
    {dev_mode, true},
    {include_erts, false}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
