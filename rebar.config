{erl_opts, [debug_info]}.

{deps, [
    {grpcbox, "0.17.1"}
]}.

{plugins, [
    grpcbox_plugin
]}.

{grpc, [
    {protos, ["apps/graphdb_api/priv/protos"]},
    {gpb_opts, [{module_name_suffix, "_pb"},
                {i, "apps/graphdb_api/priv/protos"},
                {o, "apps/graphdb_api/src"}]}
]}.

{relx, [
    {release, {seerstone, "0.1.0"},
     [nref,
      database,
      seerstone,
      grpcbox,
      graphdb_api]},
    {sys_config, "config/sys.config"},
    {dev_mode, true},
    {include_erts, false}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
