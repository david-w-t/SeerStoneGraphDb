[
  {kernel, [
    {logger_level, info},
    {logger, [
      %% Console handler — errors and above to stdout.
      {handler, default, logger_std_h, #{
        config    => #{type => standard_io},
        level     => error,
        formatter => {logger_formatter, #{
          template => [time, " [", level, "] ", mfa, ":", line, " -- ", msg, "\n"]
        }}
      }},

      %% File handler — info and above to a rotating log file.
      {handler, file_handler, logger_std_h, #{
        config => #{
          type            => {file, "log/seerstone.log"},
          file_check      => 5000,
          max_no_bytes    => 10485760,  %% 10 MB per segment
          max_no_files    => 5
        },
        level     => info,
        formatter => {logger_formatter, #{
          template => [time, " [", level, "] ", mfa, ":", line, " -- ", msg, "\n"]
        }}
      }}
    ]}
  ]},

  %% No application is named seerstone_graph_db, so only rebar3 shell
  %% (which sets every stanza by hand) makes these visible; a release
  %% ignores them.  Only data_path is read (dictionary, default "data").
  {seerstone_graph_db, [
    {app_port,       8080},
    {log_path,       "log"},
    {data_path,      "data"}
  ]},

  {graphdb, [
    %% graphdb logs a startup profile on every boot; it is a warning
    %% when the boot takes longer than this many milliseconds.
    {startup_warn_ms, 2000}
    %% Optional: {bootstrap_file, Path}.  Default: graphdb's own
    %% priv/bootstrap.terms, which exists in the source tree and in a
    %% release.
  ]},

  {mnesia, [
    {dir, "data"}
  ]}
].
