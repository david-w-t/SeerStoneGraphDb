[
  {kernel, [
    {logger_level, info},
    {logger, [
      %% Console handler — errors and above to stdout.
      {handler, default, logger_std_h, #{
        config    => #{type => standard_io},
        level     => error,
        formatter => {logger_formatter, #{
          template => [time, " [", level, "] ", mfa, ":", line, " -- ", msg, "\n"]
        }}
      }},

      %% File handler — info and above to a rotating log file.
      {handler, file_handler, logger_std_h, #{
        config => #{
          type            => {file, "log/seerstone.log"},
          file_check      => 5000,
          max_no_bytes    => 10485760,  %% 10 MB per segment
          max_no_files    => 5
        },
        level     => info,
        formatter => {logger_formatter, #{
          template => [time, " [", level, "] ", mfa, ":", line, " -- ", msg, "\n"]
        }}
      }}
    ]}
  ]},

  {seerstone_graph_db, [
    {app_port,       8080},
    {log_path,       "log"},
    {data_path,      "data"},
    {bootstrap_file, "apps/graphdb/priv/bootstrap.terms"}
  ]},

  {mnesia, [
    {dir, "data"}
  ]},

  {grpcbox, [
    {servers, [
      #{grpc_opts => #{
          service_protos => [common_pb, node_service_pb, instance_service_pb,
                              class_service_pb, attribute_service_pb,
                              rules_service_pb, language_service_pb,
                              project_service_pb, query_service_pb],
          services => #{
            'graphdb_api.NodeService'      => graphdb_api_node_service_impl,
            'graphdb_api.InstanceService'  => graphdb_api_instance_service_impl,
            'graphdb_api.ClassService'     => graphdb_api_class_service_impl,
            'graphdb_api.AttributeService' => graphdb_api_attribute_service_impl,
            'graphdb_api.RulesService'     => graphdb_api_rules_service_impl,
            'graphdb_api.LanguageService'  => graphdb_api_language_service_impl,
            'graphdb_api.ProjectService'   => graphdb_api_project_service_impl,
            'graphdb_api.QueryService'     => graphdb_api_query_service_impl
          }
        },
        listen_opts => #{port => 8081, ip => {0, 0, 0, 0}}}
    ]}
  ]}
].
